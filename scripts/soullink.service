[Unit]
Description=SoulLink server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soullink
Group=soullink
StateDirectory=soullink
StateDirectoryMode=0750
WorkingDirectory=/var/lib/soullink
Environment=SoulLink__ListenUrl=http://127.0.0.1:5080
Environment=SoulLink__DatabasePath=/var/lib/soullink/soullink.sqlite
Environment=SoulLink__PersistencePath=/var/lib/soullink/legacy-archive.json
Environment=SoulLink__PokemonDataCachePath=/var/lib/soullink/pokemon-data-cache.json
Environment=SoulLink__GameDataCachePath=/var/lib/soullink/game-data-catalog.json
Environment=SoulLink__EnableDiscordEvents=false
EnvironmentFile=/etc/soullink/server.env
ExecStart=/opt/soullink/current/PokeSoulLinkBot
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
