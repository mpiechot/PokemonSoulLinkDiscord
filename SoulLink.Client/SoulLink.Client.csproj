<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeFrameworkVersion>9.0.21</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\integration\mgba\soullink.lua" LogicalName="SoulLink.ReadOnlyBridge.lua" />
    <EmbeddedResource Include="..\integration\mgba\games.lua" LogicalName="SoulLink.GameRegistry.lua" />
    <EmbeddedResource Include="..\integration\mgba\profiles\*.lua" LogicalName="SoulLink.GameProfile.%(Filename).lua" />
    <EmbeddedResource Include="..\integration\mgba\profiles\ruby\overworld.lua" LogicalName="SoulLink.RubyOverworld.lua" />
    <EmbeddedResource Include="..\integration\mgba\profiles\ruby\trade.lua" LogicalName="SoulLink.RubyTrade.lua" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoulLink\SoulLink.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.23" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
