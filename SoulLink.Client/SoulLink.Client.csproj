<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeFrameworkVersion>9.0.21</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\integration\mgba\soullink.lua" LogicalName="SoulLink.ReadOnlyBridge.lua" />
    <EmbeddedResource Include="..\integration\mgba\overworld.lua" LogicalName="SoulLink.OverworldBridge.lua" />
    <EmbeddedResource Include="..\integration\mgba\trade.lua" LogicalName="SoulLink.TradeBridge.lua" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoulLink\SoulLink.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.23" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
