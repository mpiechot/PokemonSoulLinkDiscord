<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.15</RuntimeFrameworkVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\SoulLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoulLink.Client\SoulLink.Client.csproj" />
    <EmbeddedResource Include="$(MgbaBundlePath)" LogicalName="SoulLink.mGBA.zip" Condition="'$(MgbaBundlePath)' != ''" />
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="SoulLink.Player.SoulLink.ico" />
    <EmbeddedResource Include="..\PokeSoulLinkBot\Resources\*.png" LogicalName="SoulLink.Player.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\*.png" LogicalName="SoulLink.Player.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlayerUpdateVersion)' != ''">
    <AssemblyMetadata Include="SoulLinkUpdateVersion" Value="$(PlayerUpdateVersion)" />
    <AssemblyMetadata Include="SoulLinkUpdateServer" Value="$(PlayerUpdateServer)" />
    <AssemblyMetadata Include="SoulLinkUpdatePublicKey" Value="$(PlayerUpdatePublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SoulLinkPublicBuild)' == 'true'">
    <AssemblyMetadata Include="SoulLinkPublicBuild" Value="true" />
  </ItemGroup>
</Project>
